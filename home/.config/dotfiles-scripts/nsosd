#!/bin/bash

COMMON_HINT="string:x-canonical-private-synchronous:audio-brightness"
CACHE_DIR="${XDG_RUNTIME_DIR:-/tmp}/nsosd"
mkdir -p "$CACHE_DIR"

get_device_name() {
	local target="$1"
	local cache="$CACHE_DIR/${target//[@]/_}"
	
	if [ ! -f "$cache" ]; then
		wpctl inspect "$target" | awk -F'"' '/node\.nick|node\.description/ { print $2; exit }' > "$cache"
	fi
	cat "$cache"
}

invalidate_cache() {
	rm -f "$CACHE_DIR"/*
}

notify_brightness() {
	local level=$(brightnessctl -m info | grep -o '[0-9]\+%' | tr -d '%')
	notify-send -i "brightness" -h int:value:"$level" -h "$COMMON_HINT" \
		"Brightness" "${level}%"
}

notify_sink() {
	local info volume muted name icon status
	info=$(wpctl get-volume @DEFAULT_AUDIO_SINK@)
	volume=$(echo "$info" | awk '{printf "%d", $2 * 100}')
	muted=$(echo "$info" | grep -c MUTED)
	name=$(get_device_name @DEFAULT_AUDIO_SINK@)

	if [ "$muted" -gt 0 ]; then
		icon="audio-volume-muted"; status="Muted"
	elif [ "$volume" -eq 0 ]; then
		icon="audio-volume-off"; status="${volume}%"
	elif [ "$volume" -le 33 ]; then
		icon="audio-volume-low"; status="${volume}%"
	elif [ "$volume" -le 66 ]; then
		icon="audio-volume-medium"; status="${volume}%"
	else
		icon="audio-volume-high"; status="${volume}%"
	fi

	notify-send -i "$icon" -h int:value:"$volume" -h "$COMMON_HINT" \
		"Volume • ${name}" "${status}"
}

notify_source() {
	local info volume muted name icon status
	info=$(wpctl get-volume @DEFAULT_AUDIO_SOURCE@)
	volume=$(echo "$info" | awk '{printf "%d", $2 * 100}')
	muted=$(echo "$info" | grep -c MUTED)
	name=$(get_device_name @DEFAULT_AUDIO_SOURCE@)

	if [ "$muted" -gt 0 ]; then
		icon="microphone-sensitivity-muted"; status="Muted"
	elif [ "$volume" -eq 0 ]; then
		icon="microphone-sensitivity-muted"; status="${volume}%"
	elif [ "$volume" -le 33 ]; then
		icon="microphone-sensitivity-low"; status="${volume}%"
	elif [ "$volume" -le 66 ]; then
		icon="microphone-sensitivity-medium"; status="${volume}%"
	else
		icon="microphone-sensitivity-high"; status="${volume}%"
	fi

	notify-send -i "$icon" -h int:value:"$volume" -h "$COMMON_HINT" \
		"Microphone • ${name}" "${status}"
}

case "$1" in
	brightness)     notify_brightness ;;
	sink)           notify_sink ;;
	source)         notify_source ;;
	invalidate)     invalidate_cache ;;
	*)
		echo "Usage: nsosd {brightness|sink|source|invalidate}"
		exit 1
		;;
esac